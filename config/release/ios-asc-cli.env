# MIM-92：只允许使用经过仓库审核的固定 asc 版本，不跟随 latest。
ASC_CLI_VERSION=3.4.1
ASC_CLI_RELEASE_BASE_URL=https://github.com/rorkai/App-Store-Connect-CLI/releases/download

# 官方 3.4.1 release 的 macOS 单架构产物。SHA-256 同时与 release
# checksums 文件和 GitHub release asset digest 核对过。
ASC_CLI_MACOS_ARM64_ASSET=asc_3.4.1_macOS_arm64
ASC_CLI_MACOS_ARM64_SHA256=88381683964945c0e2c74b65500725edf463a3c65725a21be2324ef1c4742a2d
ASC_CLI_MACOS_AMD64_ASSET=asc_3.4.1_macOS_amd64
ASC_CLI_MACOS_AMD64_SHA256=b6cf30fb2e2274031d7573712fde3543c76eeffdd1be2c2dd5636fcea9b3a486

# 固定 Developer ID Team，防止只校验“存在签名”却接受其他发布者。
ASC_CLI_SIGNING_TEAM_ID=YQZQG7N4WG
